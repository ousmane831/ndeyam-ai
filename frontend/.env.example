# NDEYAM AI — variables du frontend (préfixe VITE_ obligatoire, valeurs PUBLIQUES uniquement)
# Ne jamais placer de clé API ici : tout ce qui est préfixé VITE_ est visible dans le navigateur.

# URL du backend Django utilisée par le proxy de développement Vite
VITE_BACKEND_URL=http://localhost:8000
# Chemin de base de l'API (laisser /api/v1 en développement grâce au proxy)
VITE_API_BASE_URL=/api/v1
