# =============================================================================
# NDEYAM AI — variables d'environnement du backend
# Copier ce fichier en .env (ou lancer scripts/init_db.py qui le génère).
# Ne JAMAIS versionner le fichier .env.
# =============================================================================

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=a-remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production uniquement (config.settings.production) :
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000

# --- PostgreSQL (base dédiée à NDEYAM AI) -----------------------------------
DB_NAME=ndeyamai
DB_USER=ndeyamai
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_TEST_NAME=test_ndeyamai

# --- Frontend / CORS ----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Jetons JWT -----------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- E-mail (réinitialisation du mot de passe) --------------------------------
# Par défaut, les e-mails sont affichés dans la console du serveur.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=NDEYAM AI <no-reply@exemple.com>

# --- Assistant IA (LLM) ----------------------------------------------------
# LLM_PROVIDER : none | anthropic | openai_compatible | ollama
# Avec "none", l'assistant indique qu'il n'est pas configuré ; le reste de
# l'application fonctionne normalement.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# URL de base : nécessaire pour openai_compatible (ex. https://api.openai.com/v1)
# et ollama (ex. http://localhost:11434). Facultative pour anthropic.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
# Claude : repli automatique côté serveur si une réponse est refusée (True par défaut)
LLM_FALLBACKS=True
#
# Exemples :
#   LLM_PROVIDER=anthropic          LLM_MODEL=claude-opus-5-5        LLM_API_KEY=...
#   LLM_PROVIDER=openai_compatible  LLM_MODEL=<modèle>               LLM_API_KEY=...  LLM_BASE_URL=https://api.openai.com/v1
#   LLM_PROVIDER=ollama             LLM_MODEL=<modèle local>         LLM_BASE_URL=http://localhost:11434

# --- Embeddings (recherche sémantique RAG) ----------------------------------
# EMBEDDING_PROVIDER : none | openai_compatible | ollama
# Avec "none", la recherche documentaire utilise la recherche plein texte PostgreSQL.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Stockage vectoriel ---------------------------------------------------------
# numpy : similarité calculée en Python (par défaut, sans extension PostgreSQL)
# pgvector : prévu pour une version ultérieure
VECTOR_STORE_BACKEND=numpy

# --- Données de démonstration (facultatif) ---------------------------------
# Mot de passe des comptes DEMO créés par `manage.py load_demo_data` (sinon généré et affiché une fois)
# DEMO_PASSWORD=